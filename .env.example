# Copy to `.env.local` and fill in values. Next.js loads `.env.local` automatically.
# Do not commit `.env.local`.

# Public URL (production: https://litlist.onrender.com)
NEXT_PUBLIC_SITE_URL=https://litlist.onrender.com

# Eventbrite: “Private token” from your app / API keys
# (https://www.eventbrite.com/account/apps/ — create or open an app → API keys)
EVENTBRITE_API_TOKEN=

# Optional: OAuth access token if you use OAuth instead of a private token
# EVENTBRITE_OAUTH_TOKEN=

# Optional: comma-separated Eventbrite organization IDs (numeric) to pull events from
# in addition to /users/me/owned_events. Find an org id in the Eventbrite dashboard URL.
# EVENTBRITE_ORGANIZATION_IDS=123456789,987654321
